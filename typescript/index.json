{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "ignoreDeprecations": "6.0",
        "removeComments": true,
        "noFallthroughCasesInSwitch": true,
        "declaration": false,
        "sourceMap": false
    }
}
