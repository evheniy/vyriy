      "default": "./index.js"
    },
    "./router": {
      "types": "./router.d.ts",
      "import": "./router.js",
      "default": "./router.js"
    },
    "./router.js": {
      "types": "./router.d.ts",
      "import": "./router.js",
      "default": "./router.js"
