{
  "name": "@vyriy/router",
  "version": "0.1.9",
  "description": "Router utility for Vyriy projects",
  "type": "module",
  "main": "./index.js",
  "dependencies": {
    "@types/aws-lambda": "^8.10.161"
  },
  "license": "MIT",
  "types": "./index.d.ts",
  "exports": {
    ".": {
