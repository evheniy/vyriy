{
  "name": "@vyriy/script",
  "version": "0.9.3",
  "description": "Script utilities for Vyriy projects",
  "homepage": "https://vyriy.dev/docs/script/",
  "type": "module",
  "dependencies": {
    "@vyriy/config": "0.9.3",
    "@vyriy/logger": "0.9.3",
    "@vyriy/timeout": "0.9.3"
  },
  "agents": "./AGENTS.md",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evheniy/vyriy",
    "directory": "packages/script"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./compose": {
      "types": "./compose.d.ts",
      "import": "./compose.js",
      "default": "./compose.js"
    },
    "./compose.js": {
      "types": "./compose.d.ts",
      "import": "./compose.js",
      "default": "./compose.js"
    },
    "./factory": {
      "types": "./factory.d.ts",
      "import": "./factory.js",
      "default": "./factory.js"
    },
    "./factory.js": {
      "types": "./factory.d.ts",
      "import": "./factory.js",
      "default": "./factory.js"
    },
    "./index": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index.js": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./script": {
      "types": "./script.d.ts",
      "import": "./script.js",
      "default": "./script.js"
    },
    "./script.js": {
      "types": "./script.d.ts",
      "import": "./script.js",
      "default": "./script.js"
    },
    "./wrapper/error": {
