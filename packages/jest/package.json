{
  "name": "@vyriy/jest-config",
  "version": "0.3.0",
  "description": "Shared Jest config for Vyriy projects",
  "type": "module",
  "main": "./index.js",
  "dependencies": {
    "@swc/core": "^1.15.33",
    "@swc/jest": "^0.2.39",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "^17.0.0"
  },
  "agents": "./AGENTS.md",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evheniy/vyriy",
    "directory": "packages/jest"
  },
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index.js": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  }
