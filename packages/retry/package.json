{
  "name": "@vyriy/retry",
  "version": "0.1.16",
  "description": "Retry utility for Vyriy projects",
  "type": "module",
  "main": "./index.js",
  "dependencies": {
    "@vyriy/logger": "0.1.16",
    "@vyriy/pause": "0.1.16"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evheniy/vyriy",
    "directory": "packages/retry"
  },
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index.js": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./retry": {
      "types": "./retry.d.ts",
      "import": "./retry.js",
      "default": "./retry.js"
    },
    "./retry.js": {
      "types": "./retry.d.ts",
      "import": "./retry.js",
      "default": "./retry.js"
    }
  }
}
