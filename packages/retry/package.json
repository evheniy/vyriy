{
  "name": "@vyriy/retry",
  "version": "0.1.9",
  "description": "Retry utility for Vyriy projects",
  "type": "module",
  "main": "./index.js",
  "dependencies": {
    "@vyriy/logger": "0.1.9",
    "@vyriy/pause": "0.1.9"
  },
  "license": "MIT",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index.js": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./retry": {
      "types": "./retry.d.ts",
      "import": "./retry.js",
      "default": "./retry.js"
    },
    "./retry.js": {
      "types": "./retry.d.ts",
      "import": "./retry.js",
      "default": "./retry.js"
    }
  }
}
