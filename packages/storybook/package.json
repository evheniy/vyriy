{
  "name": "@vyriy/storybook-config",
  "version": "0.1.16",
  "description": "Shared Storybook config for Vyriy projects",
  "type": "module",
  "main": "./main.js",
  "dependencies": {
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-themes": "^10.3.6",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.3",
    "@storybook/react-webpack5": "^10.3.6",
    "@vueless/storybook-dark-mode": "^10.0.8",
    "css-loader": "^7.1.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.8",
    "storybook": "^10.3.6",
    "storybook-addon-pseudo-states": "^10.3.6",
    "storybook-addon-tag-badges": "^3.1.0",
    "style-loader": "^4.0.0",
    "typescript": "^6.0.3",
    "webpack": "^5.106.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evheniy/vyriy",
    "directory": "packages/storybook"
  },
  "types": "./main.d.ts",
  "exports": {
    ".": {
      "types": "./main.d.ts",
      "import": "./main.js",
      "default": "./main.js"
    },
    "./main": {
      "types": "./main.d.ts",
      "import": "./main.js",
      "default": "./main.js"
    },
    "./main.js": {
      "types": "./main.d.ts",
      "import": "./main.js",
      "default": "./main.js"
    },
    "./preview": {
      "types": "./preview.d.ts",
      "import": "./preview.js",
      "default": "./preview.js"
    },
    "./preview.js": {
      "types": "./preview.d.ts",
      "import": "./preview.js",
      "default": "./preview.js"
    }
  }
}
