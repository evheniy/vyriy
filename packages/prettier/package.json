{
  "name": "@vyriy/prettier-config",
  "version": "0.9.9",
  "description": "Shared Prettier config for Vyriy projects",
  "homepage": "https://vyriy.dev/docs/prettier/",
  "type": "module",
  "dependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-multiline-arrays": "^4.1.11"
  },
  "agents": "./AGENTS.md",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evheniy/vyriy",
    "directory": "packages/prettier"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index.js": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  }
}
