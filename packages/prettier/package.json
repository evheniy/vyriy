{
  "name": "@vyriy/prettier-config",
  "version": "0.1.9",
  "description": "Shared Prettier config for Vyriy projects",
  "type": "module",
  "main": "./index.js",
  "dependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-multiline-arrays": "^4.1.8"
  },
  "license": "MIT",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index.js": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  }
}
