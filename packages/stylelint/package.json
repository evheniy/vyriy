{
  "name": "@vyriy/stylelint-config",
  "version": "0.1.18",
  "description": "Shared Stylelint config for Vyriy projects",
  "type": "module",
  "main": "./index.js",
  "dependencies": {
    "postcss": "^8.5.14",
    "postcss-scss": "^4.0.9",
    "stylelint": "^17.11.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evheniy/vyriy",
    "directory": "packages/stylelint"
  },
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index.js": {
