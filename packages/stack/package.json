{
  "name": "@vyriy/stack",
  "version": "0.1.23",
  "description": "AWS CDK stack helpers for Vyriy infrastructure",
  "type": "module",
  "main": "./index.js",
  "dependencies": {
    "aws-cdk-lib": "^2.253.1",
    "constructs": "^10.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evheniy/vyriy",
    "directory": "packages/stack"
  },
  "types": "./index.d.ts",
