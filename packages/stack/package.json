      "import": "./certificatemanager/index.js",
      "default": "./certificatemanager/index.js"
    },
    "./cloudfront/index": {
      "types": "./cloudfront/index.d.ts",
      "import": "./cloudfront/index.js",
      "default": "./cloudfront/index.js"
    },
    "./cloudfront/index.js": {
      "types": "./cloudfront/index.d.ts",
      "import": "./cloudfront/index.js",
      "default": "./cloudfront/index.js"
    },
    "./deployment/index": {
      "types": "./deployment/index.d.ts",
