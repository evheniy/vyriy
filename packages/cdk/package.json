{
  "name": "@vyriy/cdk",
  "version": "0.9.3",
  "description": "Shared AWS CDK helpers for Vyriy projects",
  "homepage": "https://vyriy.dev/docs/cdk/",
  "type": "module",
  "dependencies": {
    "@vyriy/env": "0.9.3",
    "@vyriy/logger": "0.9.3",
    "@vyriy/package": "0.9.3",
    "@vyriy/path": "0.9.3",
    "aws-cdk-lib": "^2.261.0"
  },
  "agents": "./AGENTS.md",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evheniy/vyriy",
    "directory": "packages/cdk"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./id": {
      "types": "./id.d.ts",
      "import": "./id.js",
      "default": "./id.js"
    },
    "./id.js": {
      "types": "./id.d.ts",
      "import": "./id.js",
      "default": "./id.js"
    },
    "./index": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index.js": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./output": {
      "types": "./output.d.ts",
      "import": "./output.js",
      "default": "./output.js"
    },
    "./output.js": {
      "types": "./output.d.ts",
      "import": "./output.js",
      "default": "./output.js"
    },
    "./stack": {
      "types": "./stack.d.ts",
      "import": "./stack.js",
      "default": "./stack.js"
    },
    "./stack.js": {
      "types": "./stack.d.ts",
      "import": "./stack.js",
      "default": "./stack.js"
    }
  }
}
