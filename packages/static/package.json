{
  "name": "@vyriy/static",
  "version": "0.8.3",
  "description": "Static file and SPA serving helpers for Vyriy servers.",
  "homepage": "https://vyriy.dev/docs/static/",
  "type": "module",
  "bin": {
    "vs": "./bin/index.js",
    "vyriy-static": "./bin/index.js"
  },
  "dependencies": {
    "@vyriy/handler": "0.8.3",
    "@vyriy/router": "0.8.3",
    "@vyriy/server": "0.8.3"
  },
  "agents": "./AGENTS.md",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evheniy/vyriy",
    "directory": "packages/static"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./cache": {
      "types": "./cache.d.ts",
      "import": "./cache.js",
      "default": "./cache.js"
    },
    "./cache.js": {
      "types": "./cache.d.ts",
      "import": "./cache.js",
      "default": "./cache.js"
    },
    "./content": {
      "types": "./content.d.ts",
      "import": "./content.js",
      "default": "./content.js"
    },
    "./content.js": {
      "types": "./content.d.ts",
      "import": "./content.js",
      "default": "./content.js"
    },
    "./file": {
      "types": "./file.d.ts",
      "import": "./file.js",
      "default": "./file.js"
    },
    "./file.js": {
      "types": "./file.d.ts",
      "import": "./file.js",
      "default": "./file.js"
    },
    "./index": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index.js": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./options": {
      "types": "./options.d.ts",
      "import": "./options.js",
      "default": "./options.js"
    },
    "./options.js": {
      "types": "./options.d.ts",
      "import": "./options.js",
      "default": "./options.js"
    },
    "./server": {
      "types": "./server.d.ts",
      "import": "./server.js",
      "default": "./server.js"
    },
    "./server.js": {
      "types": "./server.d.ts",
      "import": "./server.js",
      "default": "./server.js"
    },
    "./use-spa": {
      "types": "./use-spa.d.ts",
      "import": "./use-spa.js",
      "default": "./use-spa.js"
    },
    "./use-spa.js": {
      "types": "./use-spa.d.ts",
      "import": "./use-spa.js",
      "default": "./use-spa.js"
    },
    "./use-static": {
      "types": "./use-static.d.ts",
      "import": "./use-static.js",
      "default": "./use-static.js"
    },
    "./use-static.js": {
      "types": "./use-static.d.ts",
      "import": "./use-static.js",
      "default": "./use-static.js"
    },
    "./with-static": {
      "types": "./with-static.d.ts",
      "import": "./with-static.js",
      "default": "./with-static.js"
    },
    "./with-static.js": {
      "types": "./with-static.d.ts",
      "import": "./with-static.js",
      "default": "./with-static.js"
    }
  }
}
