{
  "name": "@vyriy/commit",
  "version": "0.7.3",
  "description": "Shared commit package for Vyriy projects",
  "type": "module",
  "dependencies": {
    "@vyriy/logger": "0.7.3",
    "@vyriy/path": "0.7.3"
  },
  "agents": "./AGENTS.md",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evheniy/vyriy",
    "directory": "packages/commit"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./commit": {
      "types": "./commit.d.ts",
      "import": "./commit.js",
      "default": "./commit.js"
    },
    "./commit.js": {
      "types": "./commit.d.ts",
      "import": "./commit.js",
      "default": "./commit.js"
    },
    "./index": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index.js": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  }
}
