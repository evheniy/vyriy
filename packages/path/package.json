{
  "name": "@vyriy/path",
  "version": "0.1.10",
  "description": "Shared path utilities for Vyriy projects",
  "type": "module",
  "main": "./index.js",
  "license": "MIT",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index.js": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./path": {
      "types": "./path.d.ts",
      "import": "./path.js",
      "default": "./path.js"
    },
    "./path.js": {
      "types": "./path.d.ts",
      "import": "./path.js",
      "default": "./path.js"
    }
  }
}
